# SpendSort configuration. Copy to `.env` and edit. Never commit the real .env.
# All settings are read with the SPENDSORT_ prefix (backend/app/settings.py).

# --- LLM ---------------------------------------------------------------------
# Track 1 uses the OpenAI API directly (spec 00 F). Leave blank to run in mock mode:
# the full demo — upload, run, queue, override, learn, dashboard, export — works with
# zero spend and no key (BLOCKERS.md B3).
SPENDSORT_OPENAI_API_KEY=

# Mini-class model, per spec 00 D ("Small everything") and spec 11 section 12.
SPENDSORT_MODEL=gpt-4o-mini

# spec 11 section 8: "Temperature 0.1."
SPENDSORT_TEMPERATURE=0.1

# Force the deterministic fake LLM even when a key is present. Set to 1 for demos.
SPENDSORT_MOCK_LLM=0

# --- the confidence gate -----------------------------------------------------
# Decisions at or above this auto-apply; everything below goes to the review queue.
# Raising it queues more and protects auto-precision; lowering it does the opposite.
SPENDSORT_AUTO_THRESHOLD=0.85

# --- cost control ------------------------------------------------------------
# spec 11 section 11: "cost cap per run (default $0.25)". When a run hits the cap the
# remaining transactions are queued, never silently skipped (PLAN.md D7).
SPENDSORT_COST_CAP_USD_PER_RUN=0.25

# --- app ---------------------------------------------------------------------
SPENDSORT_ENV=dev
SPENDSORT_LOG_LEVEL=INFO
SPENDSORT_DATABASE_URL=sqlite:///./backend/spendsort.db

# --- intake hardening (spec 11 section 11) -----------------------------------
SPENDSORT_MAX_UPLOAD_BYTES=5242880
SPENDSORT_MAX_ROWS_PER_UPLOAD=5000
